{
  "name": "codex-over-cloudflare",
  "account_id": "6081c65734701e00a8ef4554443e2688",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "r.xlogic.cc", "custom_domain": true }],
  "main": "apps/relay/src/index.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "HOSTS", "class_name": "HostRelayDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegistryDO", "HostRelayDO"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
