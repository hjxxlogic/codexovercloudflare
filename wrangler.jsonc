{
  "name": "codex-over-cloudflare",
  "account_id": "6081c65734701e00a8ef4554443e2688",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "r.xlogic.cc",
      "custom_domain": true,
    },
  ],
  "main": "apps/relay/src/index.ts",
  "compatibility_date": "2026-10-24",
  "vars": {
    "ADMIN_EMAIL": "huangjielg@gmail.com",
    "ACCESS_AUD": "ae1eaf2eaabc17690f8f7b86fd9f87046c688ab255e2e3883fb74b411d99f87a",
    "ACCESS_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "https://x1x3.cloudflareaccess.com",
  },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryDO",
      },
      {
        "name": "HOSTS",
        "class_name": "HostRelayDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegistryDO", "HostRelayDO"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "head_sampling_rate": 0.1,
    },
    "traces": {
      "head_sampling_rate": 0.1,
    },
  },
}
