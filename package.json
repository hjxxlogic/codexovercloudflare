{
  "name": "codex-over-cloudflare",
  "version": "0.5.18",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev --ip 127.0.0.1 --port 8787 --var ACCESS_ENABLED:false",
    "dev:d1": "npm run build:web && tsx scripts/dev-state.ts",
    "build:web": "tsx scripts/build-web.ts",
    "build": "npm run build:native && npm run build:web && tsc --noEmit && wrangler deploy --dry-run --outdir dist/worker",
    "agent": "./build/coc-agent",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check apps packages tests scripts examples config README.md docs/USER_GUIDE.md docs/DEVELOPMENT.md docs/TEST_REPORT.md package.json tsconfig.json wrangler.jsonc vitest.config.ts eslint.config.js .prettierrc.json",
    "format": "prettier --write apps packages tests scripts examples config README.md docs/USER_GUIDE.md docs/DEVELOPMENT.md docs/TEST_REPORT.md package.json tsconfig.json wrangler.jsonc vitest.config.ts eslint.config.js .prettierrc.json",
    "test": "npm run test:cpp && vitest run",
    "test:e2e": "tsx tests/e2e.ts",
    "test:e2e:d1": "COC_STATE_BACKEND=d1 tsx tests/e2e.ts",
    "test:d1:migration": "tsx tests/d1-migration.ts",
    "test:codex": "./build/coc-tests --codex",
    "setup:local": "tsx scripts/setup-local.ts",
    "test:native": "tsx scripts/native-cli-smoke.ts",
    "test:task": "./build/coc-tests --task",
    "build:native": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j 2",
    "test:cpp": "cmake -E chdir build ctest --output-on-failure",
    "format:cpp": "find native -type f \\( -name '*.cpp' -o -name '*.hpp' \\) -exec clang-format -i {} +",
    "lint:cpp": "python3 scripts/check-cpp-format.py",
    "test:tls": "tsx tests/native-tls.ts && tsx tests/native-access.ts",
    "test:access:web": "tsx tests/browser-access.ts && tsx tests/guest-access.ts",
    "test:wake": "tsx tests/native-wake.ts && tsx tests/ui-wake.ts",
    "client": "./build/coc-client",
    "test:ui": "tsx tests/ui-stability.ts",
    "test:cache": "tsx tests/browser-cache.ts",
    "test:backup": "python3 tests/state-backup.py",
    "test:release": "python3 tests/release-provenance.py",
    "protocol:generate": "tsx scripts/gen-protocol.ts",
    "protocol:check": "tsx scripts/gen-protocol.ts --check",
    "test:update": "python3 tests/native-update.py",
    "test:billing": "tsx tests/native-demand.ts && tsx tests/native-refresh.ts",
    "test:billing:web": "tsx tests/browser-demand.ts",
    "test:projects": "tsx tests/native-projects.ts",
    "test:projects:e2e": "tsx tests/projects-e2e.ts",
    "test:delivery": "tsx tests/native-delivery.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "@humanwhocodes/retry": "0.4.3",
    "type-check": "0.4.0"
  }
}
